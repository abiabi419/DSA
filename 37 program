#include <stdio.h>

int main() {
    int a[100], n, search, count = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter element: ");
    scanf("%d", &search);

    for (int i = 0; i < n; i++) {
        if (a[i] == search)
            count++;
    }

    printf("Frequency = %d", count);

    return 0;
}
